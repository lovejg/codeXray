# DB
DATABASE_URL=postgresql://user:pass@localhost:5432/codexray

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Claude AI
ANTHROPIC_API_KEY=sk-ant-...

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Admin
# X-Admin-Key 헤더 기반 관리자 API 인증용 (스크립트/CLI)
ADMIN_KEY=change-me
# 이 이메일로 Google OAuth 가입하면 자동 ADMIN 승격.
# 비밀번호 가입은 이 이메일로 차단됨.
ADMIN_EMAIL=you@example.com

# Google OAuth
# https://console.cloud.google.com/apis/credentials 에서 발급.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Naver OAuth
# https://developers.naver.com/apps 에서 애플리케이션 등록.
# Callback URL: http://localhost:3000/api/auth/naver/callback
# 필수 제공 정보: 이메일 (필수), 별명 (권장)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=http://localhost:3000/api/auth/naver/callback

# SMTP (비밀번호 가입 이메일 인증용)
# 미설정 시 dev 모드: 인증 링크가 서버 콘솔에 출력됩니다.
# Gmail app password, Resend, SendGrid, Mailgun 등 아무거나 사용 가능.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
